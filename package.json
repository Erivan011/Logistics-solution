{
  "name": "logistics-solution",
  "version": "3.1.0",
  "private": true,
  "description": "Planejamento logístico com VRPTW, FEFO, cenários versionados e React/TypeScript",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/start-planner.mjs",
    "test": "npm run test:legacy && npm run test:planner && npm run test:ui",
    "check": "node --check web-system/frontend/app.js && node --check web-system/backend/server.js",
    "dev:ui": "vite --config planner-ui/vite.config.ts",
    "build:ui": "tsc -p planner-ui/tsconfig.json && vite build --config planner-ui/vite.config.ts && node scripts/copy-docs-assets.mjs",
    "preview:ui": "vite preview --config planner-ui/vite.config.ts",
    "start:legacy": "node web-system/backend/server.js",
    "test:legacy": "node --test web-system/tests/*.test.js",
    "test:planner": "node scripts/test-planner.mjs",
    "test:ui": "node --test planner-ui/tests/*.test.cjs",
    "preview:standalone": "node scripts/build-preview.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "swagger-ui-dist": "^5.21.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
